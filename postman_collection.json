{
  "info": {
    "name": "Daily Expenses & Cash Voucher REST API",
    "description": "Comprehensive Postman Collection for testing Daily Expense Management & Cash Voucher REST API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:4000/api/v1", "type": "string" },
    { "key": "token", "value": "", "type": "string" },
    { "key": "refreshToken", "value": "", "type": "string" }
  ],
  "item": [
    {
      "name": "1. Auth & Profile",
      "item": [
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    var json = pm.response.json();",
                  "    if (json.data && json.data.tokens) {",
                  "        pm.collectionVariables.set('token', json.data.tokens.accessToken);",
                  "        pm.collectionVariables.set('refreshToken', json.data.tokens.refreshToken);",
                  "    }",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"admin\",\n  \"password\": \"AdminPass123!\"\n}"
            },
            "url": "{{baseUrl}}/auth/login"
          }
        },
        {
          "name": "Refresh Token",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}"
            },
            "url": "{{baseUrl}}/auth/refresh"
          }
        },
        {
          "name": "Get Current User Profile (/auth/me)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{baseUrl}}/auth/me"
          }
        },
        {
          "name": "Update Profile & Username (/auth/profile)",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"admin_updated\",\n  \"fullName\": \"مدير النظام الرئيسي المطور\",\n  \"email\": \"admin.updated@company.com\"\n}"
            },
            "url": "{{baseUrl}}/auth/profile"
          }
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{baseUrl}}/auth/logout"
          }
        }
      ]
    },
    {
      "name": "2. Today Auto Journal",
      "item": [
        {
          "name": "Get Today Overview",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{baseUrl}}/today"
          }
        },
        {
          "name": "Get Today Transactions",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{baseUrl}}/today/transactions"
          }
        },
        {
          "name": "Create Today Transaction",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"manualVoucherNumber\": \"1055\",\n  \"voucherBookNumber\": \"BK-01\",\n  \"voucherSource\": \"MANUAL\",\n  \"transactionType\": \"PURCHASE\",\n  \"amount\": 350.00,\n  \"description\": \"شراء مواد صيانة وتشغيل كهربائي\",\n  \"beneficiaryId\": 1,\n  \"categoryId\": 1,\n  \"paymentMethodId\": 1,\n  \"invoiceStatus\": \"PROVIDED\",\n  \"invoiceNumber\": \"INV-99881\",\n  \"invoiceDate\": \"2026-08-24\",\n  \"invoiceAmount\": 350.00\n}"
            },
            "url": "{{baseUrl}}/today/transactions"
          }
        },
        {
          "name": "Update Today Transaction",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"amount\": 400.00,\n  \"description\": \"تعديل بيان المصروف والمبلغ\"\n}"
            },
            "url": "{{baseUrl}}/today/transactions/1"
          }
        },
        {
          "name": "Delete Today Transaction",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{baseUrl}}/today/transactions/1"
          }
        }
      ]
    },
